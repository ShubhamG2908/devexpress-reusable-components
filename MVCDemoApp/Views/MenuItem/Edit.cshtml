@model ModelsProject.MenuItem

@{
    ViewData["Title"] = "Edit";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>Edit</h1>

<h4>MenuItem</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        @using (Html.BeginForm("Edit", "MenuItem", new { id = Model.Id }, FormMethod.Post))
        {
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Id" class="control-label"></label>
                <input asp-for="Id" class="form-control" readonly />
                <span asp-validation-for="Id" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Text" class="control-label"></label>
                @Html.TextBoxFor(m => m.Text, Model.Text, new { @class = "form-control" })
                @Html.ValidationMessage("Text", "", new { @class = "text-danger" })
            </div>
            <div class="form-group form-check">
                <label class="form-check-label">
                    @Html.CheckBoxFor(m => m.Disabled,Model.Disabled)
                    @* <input class="form-check-input" asp-for="Disabled" /> @Html.DisplayNameFor(model => model.Disabled) *@
                </label>
            </div>
            <div class="form-group">
                <label asp-for="Icon" class="control-label"></label>
                @Html.TextBoxFor(m => m.Icon, Model.Icon, new { @class = "form-control" })
                @Html.ValidationMessage("Icon", "", new { @class = "text-danger" })
            </div>
            <div class="form-group">
                <label asp-for="Url" class="control-label"></label>
                @Html.TextBoxFor(m => m.Url, Model.Url, new { @class = "form-control" })
                @Html.ValidationMessage("Url", "", new { @class = "text-danger" })
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        }
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

